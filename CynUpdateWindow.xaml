<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CYN · Updates" Width="746" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
  <Window.Resources>
    <!-- Material-inspired surfaces that match CYN's dark color system. -->
    <SolidColorBrush x:Key="Accent" Color="#8EE4E1"/>
    <SolidColorBrush x:Key="OnSurface" Color="#F0F6FF"/>
    <SolidColorBrush x:Key="Muted" Color="#A3B5C9"/>
    <SolidColorBrush x:Key="Outline" Color="#344657"/>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#09171C"/>
      <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Background" Value="#8EE4E1"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="16"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B4F6F0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TonalButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#E4F1F7"/>
      <Setter Property="Background" Value="#273846"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#354B5D"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Gentle breathing dot indicates activity; percentages remain real. -->
    <Storyboard x:Key="ActiveMotion" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="StatusPulse" Storyboard.TargetProperty="Opacity"
                       From="0.40" To="0.92" AutoReverse="True" Duration="0:0:1.3"/>
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard Storyboard="{StaticResource ActiveMotion}"/>
    </EventTrigger>
  </Window.Triggers>
  <Border Background="#101720" BorderBrush="#3B5060" BorderThickness="1"
          CornerRadius="28" Margin="10">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="33" ShadowDepth="9" Opacity="0.47"/>
    </Border.Effect>
    <Grid Margin="26,21,26,21">
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="112"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="78"/>
      </Grid.RowDefinitions>
      <!-- The title bar intentionally supports window dragging (wired in PowerShell). -->
      <Grid x:Name="DragSurface" Grid.Row="0" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#8EE4E1" CornerRadius="11" Width="35" Height="35">
            <TextBlock Text="C" FontFamily="Segoe UI Semibold" FontSize="20"
                       Foreground="#0B1D22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CYN" Foreground="#F0F6FF" FontFamily="Segoe UI Semibold"
                       FontSize="16"/>
            <TextBlock Text="Software updates" Foreground="#A3B5C9"
                       FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <Border HorizontalAlignment="Right" Background="#213640"
                BorderBrush="#395663" BorderThickness="1"
                CornerRadius="11" Padding="12,6" VerticalAlignment="Center">
          <TextBlock Text="OFFICIAL RELEASE" Foreground="#8EE4E1"
                     FontSize="10" FontWeight="SemiBold"/>
        </Border>
      </Grid>

      <Border Grid.Row="1" Background="#182832" CornerRadius="22" Padding="22,15"
              BorderBrush="#304853" BorderThickness="1" Margin="0,7,0,13">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="235"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Stay in tune." Foreground="#F0F6FF"
                       FontSize="25" FontFamily="Segoe UI Semibold"/>
            <TextBlock Text="A smoother, safer CYN update experience."
                       Foreground="#A3B5C9" FontSize="12" Margin="0,6,0,0"/>
          </StackPanel>
          <Grid Grid.Column="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="INSTALLED" Foreground="#91A7B6" FontSize="10"/>
              <TextBlock x:Name="CurrentVersionText" Text="v—"
                         Foreground="#F0F6FF" FontSize="16" FontFamily="Segoe UI Semibold"
                         Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="AVAILABLE" Foreground="#91A7B6" FontSize="10"/>
              <TextBlock x:Name="LatestVersionText" Text="Checking…"
                         Foreground="#8EE4E1" FontSize="16" FontFamily="Segoe UI Semibold"
                         Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#17222E" BorderBrush="#304050"
              BorderThickness="1" CornerRadius="22" Padding="24,19,24,17">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Grid Width="28" Height="28" DockPanel.Dock="Left" Margin="0,0,10,0">
              <Ellipse Fill="#31575B" Width="26" Height="26"/>
              <Ellipse x:Name="StatusPulse" Fill="#8EE4E1" Width="11" Height="11"/>
            </Grid>
            <TextBlock x:Name="StageTitle" Text="Checking for updates"
                       Foreground="#F0F6FF" FontFamily="Segoe UI Semibold"
                       FontSize="20" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock x:Name="StageDetail" Text="Contacting official CYN releases…"
                     TextWrapping="Wrap" MaxHeight="38" Margin="0,9,0,16"
                     Foreground="#A3B5C9" FontSize="12"/>
          <Border Background="#2E424D" Height="9" CornerRadius="5" ClipToBounds="True">
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="0"
                         Foreground="#8EE4E1" Background="#2E424D"
                         BorderThickness="0" Height="9"/>
          </Border>
          <Grid Margin="0,8,0,14">
            <TextBlock x:Name="ProgressText" Text="Connecting securely"
                       Foreground="#A3B5C9" FontSize="11"/>
            <TextBlock x:Name="PercentText" Text="" HorizontalAlignment="Right"
                       Foreground="#8EE4E1" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StepCheck" Grid.Column="0" Background="#31565A" CornerRadius="11"
                    Padding="6,9" Margin="0,0,5,0">
              <TextBlock Text="1  Check" Foreground="#D6EDEB" FontSize="11"
                         HorizontalAlignment="Center"/>
            </Border>
            <Border x:Name="StepDownload" Grid.Column="1" Background="#273846" CornerRadius="11"
                    Padding="6,9" Margin="0,0,5,0">
              <TextBlock Text="2  Download" Foreground="#C0D1DB" FontSize="11"
                         HorizontalAlignment="Center"/>
            </Border>
            <Border x:Name="StepVerify" Grid.Column="2" Background="#273846" CornerRadius="11"
                    Padding="6,9" Margin="0,0,5,0">
              <TextBlock Text="3  Verify" Foreground="#C0D1DB" FontSize="11"
                         HorizontalAlignment="Center"/>
            </Border>
            <Border x:Name="StepInstall" Grid.Column="3" Background="#273846" CornerRadius="11"
                    Padding="6,9">
              <TextBlock Text="4  Install" Foreground="#C0D1DB" FontSize="11"
                         HorizontalAlignment="Center"/>
            </Border>
          </Grid>
        </StackPanel>
      </Border>

      <Grid Grid.Row="3" Margin="4,9,4,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Protected download" Foreground="#DCEAF0"
                     FontSize="12" FontWeight="SemiBold"/>
          <TextBlock Text="SHA-256 verified  ·  Installed only with your approval"
                     Foreground="#A3B5C9" FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="LaterButton" Grid.Column="1" Content="Later"
                Width="102" Height="43" Margin="0,0,11,0" Visibility="Collapsed"
                Style="{StaticResource TonalButton}"/>
        <Button x:Name="ActionButton" Grid.Column="2" Content="Cancel"
                Width="166" Height="43" Style="{StaticResource PrimaryButton}"/>
      </Grid>
    </Grid>
  </Border>
</Window>