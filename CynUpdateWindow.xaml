<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyn — Updating" Width="710" Height="472"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#8DDDEB"/>
    <Storyboard x:Key="CynMotion" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="CorePulse" Storyboard.TargetProperty="Opacity"
                       From="0.32" To="0.80" Duration="0:0:1.45" AutoReverse="True"/>
      <DoubleAnimation Storyboard.TargetName="OrbitA" Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:9"/>
      <DoubleAnimation Storyboard.TargetName="OrbitB" Storyboard.TargetProperty="Angle"
                       From="360" To="0" Duration="0:0:13"/>
      <DoubleAnimation Storyboard.TargetName="ParticleA" Storyboard.TargetProperty="X"
                       From="-146" To="0" Duration="0:0:2.6"/>
      <DoubleAnimation Storyboard.TargetName="ParticleB" Storyboard.TargetProperty="Y"
                       From="128" To="0" Duration="0:0:3.2"/>
      <DoubleAnimation Storyboard.TargetName="ParticleC" Storyboard.TargetProperty="X"
                       From="170" To="0" Duration="0:0:3.6"/>
      <DoubleAnimation Storyboard.TargetName="ParticleD" Storyboard.TargetProperty="Y"
                       From="-118" To="0" Duration="0:0:2.9"/>
    </Storyboard>
  </Window.Resources>
  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard Storyboard="{StaticResource CynMotion}"/>
    </EventTrigger>
  </Window.Triggers>
  <Border CornerRadius="24" BorderBrush="#36515A" BorderThickness="1"
          Background="#14191E" Margin="9">
    <Border.Effect>
      <DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="215"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="25,14,25,0">
        <TextBlock Text="CYN  /  SYSTEM UPDATE" Foreground="#E7F3F5"
                   FontFamily="Segoe UI Semibold" FontSize="12" VerticalAlignment="Center"/>
        <TextBlock Text="SECURE GITHUB RELEASE" Foreground="#77939C"
                   FontFamily="Segoe UI" FontSize="10" HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
      </Grid>
      <Grid Grid.Row="1" ClipToBounds="True">
        <Canvas Width="390" Height="205" HorizontalAlignment="Center">
          <Ellipse Width="232" Height="118" Canvas.Left="78" Canvas.Top="42"
                   Stroke="#355A64" StrokeThickness="1" Opacity="0.7">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="OrbitA" CenterX="116" CenterY="59"/>
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="164" Height="166" Canvas.Left="114" Canvas.Top="22"
                   Stroke="#408093" StrokeThickness="1" Opacity="0.7">
            <Ellipse.RenderTransform>
              <RotateTransform x:Name="OrbitB" CenterX="82" CenterY="83"/>
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="132" Height="132" Canvas.Left="130" Canvas.Top="38" Opacity="0.7">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#5CDAED" Offset="0"/>
                <GradientStop Color="#153C4B" Offset=".56"/>
                <GradientStop Color="#00171E" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
              <BlurEffect Radius="18"/>
            </Ellipse.Effect>
          </Ellipse>
          <Ellipse Width="78" Height="78" Canvas.Left="157" Canvas.Top="65"
                   Stroke="#B3EEF4" StrokeThickness="1.7" Opacity="0.75">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#95E9F0" Offset="0"/>
                <GradientStop Color="#286779" Offset=".7"/>
                <GradientStop Color="#163440" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse x:Name="CorePulse" Width="96" Height="96" Canvas.Left="148" Canvas.Top="56"
                   Stroke="#85EDFF" StrokeThickness="1.5" Opacity=".6"/>
          <Ellipse Width="5" Height="5" Fill="#B6F6FF" Canvas.Left="191" Canvas.Top="100">
            <Ellipse.RenderTransform><TranslateTransform x:Name="ParticleA"/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="4" Height="4" Fill="#78CFE6" Canvas.Left="195" Canvas.Top="103">
            <Ellipse.RenderTransform><TranslateTransform x:Name="ParticleB"/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="6" Height="6" Fill="#E1FFFF" Canvas.Left="191" Canvas.Top="102">
            <Ellipse.RenderTransform><TranslateTransform x:Name="ParticleC"/></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="3" Height="3" Fill="#73D3EA" Canvas.Left="195" Canvas.Top="102">
            <Ellipse.RenderTransform><TranslateTransform x:Name="ParticleD"/></Ellipse.RenderTransform>
          </Ellipse>
        </Canvas>
      </Grid>
      <StackPanel Grid.Row="2" Margin="38,3,38,26">
        <TextBlock x:Name="StageTitle" Text="Checking for updates"
                   FontFamily="Segoe UI Semibold" FontSize="21" Foreground="#F1FCFF"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="StageDetail" Text="Connecting to the official Cyn GitHub releases…"
                   FontFamily="Segoe UI" FontSize="12" Foreground="#A4BCC3"
                   HorizontalAlignment="Center" Margin="0,8,0,17"/>
        <Border Background="#293D43" Height="7" CornerRadius="4">
          <Grid ClipToBounds="True">
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100"
                         Value="0" Height="7" Foreground="#8DDDEB"
                         Background="#293D43" BorderThickness="0"/>
          </Grid>
        </Border>
        <Grid Margin="1,8,1,15">
          <TextBlock x:Name="ProgressText" Text="Checking…" Foreground="#A8C0C8"
                     FontSize="11"/>
          <TextBlock x:Name="PercentText" Text="" Foreground="#C8EFF5"
                     FontSize="11" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Height="38">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Cyn updater  •  SHA-256 verification" Foreground="#738F99"
                     FontSize="10" VerticalAlignment="Center"/>
          <Button x:Name="LaterButton" Grid.Column="1" Width="96" Height="32"
                  Content="Later" Visibility="Collapsed" Foreground="#E6F4F7"
                  Background="#283840" BorderBrush="#48616B" Margin="0,0,9,0"/>
          <Button x:Name="ActionButton" Grid.Column="2" Width="148" Height="32"
                  Content="Cancel" Foreground="#142127"
                  Background="#8DDDEB" BorderBrush="#8DDDEB"/>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
